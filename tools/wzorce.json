      "pliki": ["WypozyczalniaWeb/*.aspx"]
    },
    {
      "nazwa": "WebForms — code-behind",
      "opis": "Kod strony powiązany z markupem ASPX.",
      "pliki": ["WypozyczalniaWeb/*.aspx.vb"]
    },
    {
      "nazwa": "WebForms — designer",
      "opis": "Deklaracje wygenerowane dla kontrolek strony.",
      "pliki": ["WypozyczalniaWeb/*.designer.vb"]
    },
    {
      "nazwa": "Cykl życia aplikacji Web",
      "opis": "Global.asax i jego kod VB.",
      "pliki": ["WypozyczalniaWeb/Global.asax", "WypozyczalniaWeb/Global.asax.vb"]
    },
    {
      "nazwa": "Proxy SOAP",
