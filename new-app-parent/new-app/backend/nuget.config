<?xml version="1.0" encoding="utf-8"?>
<!-- Zrodlo pakietow dla backendu: tylko oficjalne nuget.org (konfiguracja uzytkownika moze nie miec zadnego zrodla). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
